PORT=5000
NODE_ENV=development

# Database Connection (Choose one):
# Option A: Local MongoDB
MONGO_URI=mongodb://localhost:27017/learnitics

# Option B: MongoDB Atlas Cloud (Uncomment and replace with your credentials)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/learnitics?retryWrites=true&w=majority&appName=Cluster0

# Authentication & Security
JWT_SECRET=your_jwt_super_secret_mastery_key_here
JWT_EXPIRES_IN=7d

# Client URL (CORS)
CLIENT_URL=http://localhost:5173
